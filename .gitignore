dist/*
# The committed skill dist tree is the install source for this repo.
# scripts/package-skill.sh produces it; tests/package/check-package.sh
# blocks merges when sources drift from this tree.
!dist/agent-workflow/
build/
.gradle/
# Fixture build/ directories carry redline-verdict.json artifacts that
# are part of the checker test scenarios — they must be tracked.
!tests/**/build/
# Local skill installs are regenerated via scripts/package-skill.sh, so
# they're gitignored — EXCEPT the agent-workflow skill itself. This repo
# dogfoods agent-workflow, and its committed .claude/hooks/ point at
# /agent-workflow, so the skill is committed too: a fresh clone is
# governed with no manual install step, and the committed hooks don't
# reference a missing skill. Kept in lockstep with dist/agent-workflow/
# by tests/package/check-committed-skill.sh.
.claude/skills/*
!.claude/skills/agent-workflow/
# Codex mirror install (.agents/skills/) is regenerated locally.
.agents/skills/
__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store
*.log
.local/

.claude/settings.local.json

# Git worktrees (created by scripts/install-skill-locally.sh or manual git worktree add)
.worktrees/
.claude/worktrees/
