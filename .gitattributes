# Normalize line endings across platforms.
#
# Without this, Windows checkouts can pick up CRLF on text files Git
# previously stored as LF — which breaks scripts run through `bash`
# (bash treats CRLF lines as `$'\r'` syntax errors). The settings here
# pin LF for the files the bash harness actually executes, and let Git
# auto-detect everything else.

# All text files: normalize to LF in the repo; checkout uses the OS
# native ending. Shell scripts and YAML are forced to LF on checkout
# too because they get parsed by tools that don't tolerate CRLF.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Treat the vendored checker as text too — it's a Python script and
# the demo repo's CI invokes it with `python`.
scripts/agent-workflow-check.py text eol=lf
